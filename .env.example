# Copy to .env on the server and fill in. Never commit the filled-in version.

# Domain Caddy should request a certificate for. Must already point at this
# VPS's IP or the certificate request will fail.
DOMAIN=bikerentalsbhuntar.com

# Where Let's Encrypt sends a warning if a renewal ever fails. Worth setting:
# it's the only notice you'd get before a certificate expires.
ACME_EMAIL=offhorizonadventure@gmail.com

# Public — compiled into the browser bundle. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Server-side only. Never add a NEXT_PUBLIC_ prefix to any of these: it would
# inline them into the JavaScript every visitor downloads, handing out the
# ability to forge payment signatures and full read/write on the database.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
